# ==============================================================================
# ClubHub Bot Environment Configuration
# ==============================================================================

# Required: Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Optional: Path to YAML configuration file (default: config.yaml)
CONFIG_PATH=config.yaml

# Optional: Path to SQLite database file (default: clubhub.db)
DATABASE_PATH=clubhub.db

# Optional: Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Optional: Google Sheets Credentials (JSON service account file)
# Only required if Google Sheets reporting is enabled in config.yaml
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
